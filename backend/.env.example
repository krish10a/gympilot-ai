# Backend Environment Variables (Deploy to Render)

# Supabase PostgreSQL Connection String (Transaction pooler or Direct)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./gympilot.db

# NVIDIA NIM API Key for Nemotron-3 Fusion & Coach agents
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Pinecone Vector Database API Key for episodic memory
PINECONE_API_KEY=your_pinecone_api_key_here

# Optional: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origin for CORS (set to your Vercel deployment URL in production)
FRONTEND_URL=*
